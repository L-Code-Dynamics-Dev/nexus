{
  "name": "nexus",
  "version": "0.0.1",
  "private": true,
  "description": "E-commerce Operating System — unified canonical platform",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "build": "tsc --noEmit",
    "test:workers": "vitest run -c vitest.workers.config.ts",
    "kar:dev": "wrangler dev --config apps/kar/wrangler.jsonc",
    "kar:typecheck": "tsc --project apps/kar/tsconfig.json",
    "kar:deploy:dry-run": "wrangler deploy --dry-run --config apps/kar/wrangler.jsonc",
    "kar:deploy": "wrangler deploy --config apps/kar/wrangler.jsonc"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.0",
    "@cloudflare/workers-types": "5.20261009.1",
    "@types/node": "22",
    "@types/papaparse": "5.5.2",
    "typescript": "5.5.4",
    "vitest": "4.1.11",
    "wrangler": "4.149.0"
  },
  "dependencies": {
    "csv-parse": "7.0.3",
    "csv-stringify": "6.5.1",
    "decimal.js": "10.4.3",
    "papaparse": "5.7.0",
    "zod": "4.4.3"
  }
}
